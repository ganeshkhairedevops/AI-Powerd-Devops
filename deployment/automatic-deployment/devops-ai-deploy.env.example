# Copy this file to /etc/devops-ai-deploy.env and set a valid token.
# Never commit the real /etc/devops-ai-deploy.env file or its token.
GITHUB_TOKEN=REPLACE_WITH_GITHUB_FINE_GRAINED_TOKEN
REPO=ganeshkhairedevops/AI-Powerd-Devops
BRANCH=feat-github-actions
WORKFLOW=docker-publish.yml
APP_DIR=/opt/AI-Powerd-Devops/Application
BACKEND_IMAGE=ganeshkhaire14/devops-ai-backend
FRONTEND_IMAGE=ganeshkhaire14/devops-ai-frontend
STATE_DIR=/var/lib/devops-ai-deploy
